# Copy this file to .env (same folder as docker-compose.yml) and fill in
# your own key. .env is gitignored — never commit real secrets.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — defaults to a fixed free model slug if unset. Browse current
# free-tier models at https://openrouter.ai/models?max_price=0 (slugs rotate
# over time, so check there if the default stops working).
OPENROUTER_MODEL=openai/gpt-oss-120b:free
